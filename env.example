BOT_TOKEN=123456789:replace_with_token_from_BotFather
BOT_USERNAME=replace_with_bot_username
APP_URL=https://IdrisStudy.bothost.tech
WEBHOOK_SECRET=replace_with_random_letters_numbers_dashes_or_underscores
PORT=5000
BOT_DB_PATH=idris_bot.sqlite3
# polling (по умолчанию) — безопасен при любом порте; webhook — когда домен точно отдаёт наш сервер
TELEGRAM_MODE=polling
# 1 — поднимать веб-сервер; 0 — только бот
RUN_WEB=1
